# =========================
# Environment / Secrets
# =========================
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Keep only the template .env.production files tracked but WITHOUT real secrets
!.env.production
!backend/.env.production
!frontend/.env.production

# =========================
# Node Modules
# =========================
node_modules/
backend/node_modules/
frontend/node_modules/

# =========================
# Build Outputs
# =========================
frontend/build/

# =========================
# Logs
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/
logs/

# =========================
# Upload / Recording Data
# =========================
backend/uploads/*
backend/recordings/*
!backend/uploads/.gitkeep
!backend/recordings/.gitkeep

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Docker
# =========================
.docker/
